extends ../../layouts/default.pug
include ../../mixins/alert-success.pug
include ../../mixins/alert-error.pug
block main 
    +alertSuccess(3000)
    +alertError(3000)
    h1(class="mb-4") Chỉnh sửa nhóm quyền

    form(
        action=`${prefixAdmin}/roles/edit/${record.id}?_method=PATCH`
        id="form-edit-product"
        method="POST"
    )
        div(class="form-group")
            label(for="title") Tiêu đề
            input(
                type="text"
                class="form-control"
                id="title"
                name="title"
                value=record.title
                required
            )
        div(class="form-group")
            label(for="desc") Mô tả
            textarea(
                class="form-control tiny-mce" 
                id="desc"
                name="description"
                rows="5"
            ) #{record.description}
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Cập nhật   