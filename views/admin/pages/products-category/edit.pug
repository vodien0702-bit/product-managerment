extends ../../layouts/default.pug
include ../../mixins/alert-success.pug
include ../../mixins/alert-error.pug
include ../../mixins/select-tree.pug
block main 
    +alertSuccess(3000)
    +alertError(3000)
    h1(class="mb-4") Chỉnh sửa sản phẩm

    form(
        action=`${prefixAdmin}/products-category/edit/${productCategory.id}?_method=PATCH`
        id="form-edit-product"
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="title") Tiêu đề
            input(
                type="text"
                class="form-control"
                id="title"
                name="title"
                value=productCategory.title
                required
            )
        div(class="form-group")
            label(for="parent_id") Danh mục cha
            select(
                class="form-control"
                id="parent_id"
                name="parent_id"
            )
                option(value="") --Chọn danh mục cha--
                if(records)
                    +select-tree(records)
        div(class="form-group")
            label(for="desc") Mô tả
            textarea(
                class="form-control tiny-mce" 
                id="desc"
                name="description"
                rows="5"
            ) !{productCategory.description}
        div(
            class="form-group"
            upload-image
        )
            label(for="thumbnail") Ảnh
            input(
                type="file"
                class="form-control-file"
                id="thumbnail"
                name="thumbnail"
                accept="image/*"
                upload-image-input
            )
            img(
                src=productCategory.thumbnail
                alt=productCategory.title
                upload-image-preview
                class="image-preview"
                style="width: 150px"
            )
        div(class="form-group")
            label(for="position") Vị trí
            input(
                type="number"
                class="form-control"
                id="position"
                name="position"
                placeholder="Tự động tăng"
                min="1"
                value=productCategory.position
            )
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusActive"
                name="status"
                value="active"
                checked=productCategory.status == 'active' ? true : false
            )
            label(for="statusActive" class="form-check-label") Hoạt động
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusInActive"
                name="status"
                value="inActive"
                checked=productCategory.status == 'inActive' ? true : false
            )
            label(for="statusInActive" class="form-check-label") Dừng hoạt động
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
            ) Cập nhật   