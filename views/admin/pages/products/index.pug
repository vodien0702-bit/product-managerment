extends ../../layouts/default
include ../../mixins/filter-status
include ../../mixins/search
include ../../mixins/pagination
include ../../mixins/form-change-multi
include ../../mixins/alert-success
include ../../mixins/alert-error
include ../../mixins/sort
block main
    if (role.permissions.includes("products_view"))
        h1 Danh sách sản phẩm
        +alertSuccess(3000)
        +alertError(3000)
        .card.mb-3
            .card-header Bộ lọc và Tìm kiếm
            .card-body
                .row
                    .col-6
                        +filter-status(filterStatus)
                    .col-6        
                        +search(keyword)
        .card.mb-3 
            .card-header Sắp xếp
            .card-body
                .row
                    .col-4
                        +sort
        .card.mb-3  
            .card-header Danh sách
            .card-body
                .row
                    .col-8
                        if(role.permissions.includes("products_edit"))
                            +formChangeMulti(`${prefixAdmin}/products/change-multi-status?_method=PATCH`)
                    .col-4
                        if(role.permissions.includes("products_create"))
                            a(
                                href=`${prefixAdmin}/products/create`
                                class="btn btn-outline-success"
                            ) + Thêm mới
                .row
                    table(
                        class="table table-hover table-sm"
                        checkbox-multi
                    )
                        thead
                            tr
                                if(role.permissions.includes("products_edit"))
                                    th  
                                        input(type="checkbox" name="checkall")
                                th STT
                                th Hình ảnh
                                th Tiêu đề
                                th Giá
                                th Vị trí
                                th Trạng thái
                                th Người tạo
                                th Hành động

                        tbody 
                            each item, index in products
                                tr
                                    if(role.permissions.includes("products_edit"))
                                        td 
                                            input(
                                                type="checkbox"
                                                name="id"
                                                value=item.id
                                            )
                                    td #{objectPagination.limitItems*(objectPagination.currentPage - 1) + (index + 1)}
                                    td
                                        img(
                                            src=item.thumbnail
                                            alt=item.title
                                            style="width: 100px; height: auto;"
                                        )
                                    td #{item.title}
                                    td #{item.priceNew}$
                                    td 
                                        input(
                                            type="number"
                                            value=item.position
                                            style="width: 60px"
                                            min="1"
                                            name="position"
                                        )
                                    if(role.permissions.includes("products_edit"))
                                        td
                                            if(item.status == 'active')
                                                a(
                                                    href="javascript:;" 
                                                    class="badge badge-success"
                                                    data-id=item.id
                                                    data-status=item.status
                                                    button-change-status
                                                ) Hoạt động
                                            else 
                                                a(
                                                    href="javascript:;" 
                                                    class="badge badge-danger"
                                                    data-id=item.id
                                                    data-status=item.status
                                                    button-change-status
                                                ) Dừng hoạt động
                                    else
                                        td
                                            if(item.status == 'active')
                                                div(
                                                    class="badge badge-success"
                                                ) Hoạt động
                                            else 
                                                div(
                                                    class="badge badge-danger"
                                                ) Dừng hoạt động
                                    td 
                                        p #{item.createBy.accountFullName}
                                        span #{moment(item.createBy.createAt).format("DD/MM/YYYY HH:mm:ss")}
                                    td
                                        if(role.permissions.includes("products_view"))
                                            a(
                                                href=`${prefixAdmin}/products/detail/${item.slug}`
                                                class="btn btn-secondary btn-sm"
                                            ) Chi tiết
                                        if(role.permissions.includes("products_edit"))
                                            a(
                                                href=`${prefixAdmin}/products/edit/${item.id}`
                                                class="btn btn-warning btn-sm"
                                            ) Sửa
                                        if(role.permissions.includes("products_delete"))
                                            button(
                                                class="btn btn-danger btn-sm"
                                                button-delete=item.id
                                            ) Xóa

        +pagination(objectPagination)
        form(
            action=""
            method="POST"
            id="form-change-status"
            data-path=`${prefixAdmin}/products/change-status`
        )
        form(
            action=""
            method="POST"
            id="form-delete"
            data-path=`${prefixAdmin}/products/delete`
        )


    script(src="/admin/script/products.js") 